# Copy to your shell or MCP client config. Sightline reads plain environment
# variables — there is no dotenv loader, so export these or paste them into
# your client's env/environment block. See readme.md for full documentation.
#
# --- vision backend (pick at least one) ---
# GEMINI_API_KEY=your_api_key_here
# GEMINI_VISION_MODEL=gemini-2.5-flash
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_VISION_MODEL=moondream
# SIGHTLINE_BACKENDS=gemini,ollama
#
# --- folders ---
# SIGHTLINE_WATCH_FOLDER=~/.sightline/images
#
# --- cache ---
# SIGHTLINE_CACHE_MAX_SIZE=100
# SIGHTLINE_CACHE_TTL_MS=86400000
# SIGHTLINE_CACHE_PERSIST=1
# SIGHTLINE_CACHE_FILE=~/.sightline/cache.json
#
# --- throttle ---
# SIGHTLINE_MAX_CONCURRENT=1
# SIGHTLINE_MIN_INTERVAL_MS=0
#
# --- clipboard (opt-in: a clipboard can hold secrets) ---
# SIGHTLINE_CLIPBOARD=0
# SIGHTLINE_CLIPBOARD_INTERVAL_MS=1000
#
# --- limits ---
# SIGHTLINE_MAX_IMAGE_BYTES=10485760
