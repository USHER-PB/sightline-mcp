{
  "name": "sightline-mcp",
  "version": "0.2.0",
  "description": "Universal Image Vision Bridge MCP Server - enables vision for non-vision-capable coding agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "sightline-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:test && node --test dist-test/test/*.test.js",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "vision",
    "gemini",
    "ai",
    "coding-agent"
  ],
  "author": "USHER-PB",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/USHER-PB/sightline-mcp.git"
  },
  "homepage": "https://github.com/USHER-PB/sightline-mcp#readme",
  "bugs": {
    "url": "https://github.com/USHER-PB/sightline-mcp/issues"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
